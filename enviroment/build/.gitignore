# stm32cubemx gitignore since there isnt a offical one ? its been like 10 years

# --- Compilation Artifacts & Binaries ---
*.o
*.obj
*.d
*.crf
*.lnp
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.su

# --- Build Directories ---
shared/

# --- STM32CubeIDE / Eclipse Metadata & Settings ---
.metadata/
.settings/
.launch/
remote_connections.xml

# --- STM32CubeMX Backup Files ---
# CubeMX sometimes creates copies when regenerating code
*.backup

# --- Keil uVision Specifics ---
*.uvguix.*
*.uv2.bak
*.uvopt.bak
*.uvpmw.bak
*.wdg
*.clog
*.lst
*.htm
*.dep

# --- IAR Embedded Workbench Specifics ---
*.dep
*.ewt
*.ewd
*.wsdt
*.i79
Settings/
Flash/

# --- VS Code & CMake (if using VS Code workflow) ---
.vscode/
CMakeUserPresets.json
CMakeFiles/
CMakeCache.txt
Makefile-cmake

# --- OS Specific Files ---
.DS_Store
Thumbs.db
