# the name of the CubeMX project, also needs a machine config file of the same name
BOARD_NAME=ref-157d-dk1

# user created within the container
USER_NAME=dev

# host path to yocto cache, make sure the container user (above) has rw access. or be lazy and do "sudo chmod 777 ~/yocto_cache"
YOCTO_CACHE_DIR=~/yocto_cache
