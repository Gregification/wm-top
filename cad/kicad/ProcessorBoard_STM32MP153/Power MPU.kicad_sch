	(text_box "hierarchical nets\n\n\n\n\n\n\n\n\n	- ~5v in min ampacity \n	 = Vin + VLXBST + buck1 + buck2 + buck3 + buck4\n	 = @{1.2 + 2000 + 1600 + 1000 + 3000}mA\n	- ~3v in min ampacity\n	 = sum(LDO[1,2,6,5])\n	 = @{800 + 800 + 350 + 800}mA"
		(exclude_from_sim no)
