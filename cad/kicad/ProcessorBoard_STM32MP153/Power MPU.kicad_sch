	(text_box "hierarchical nets\n\n\n\n\n\n\n\n\n	- ~5v max current, non-failure worst case\n	 = Vin + VLXBST + buck1 + buck2 + buck3 + buck4\n	 = @{1.2 + 2000 + 1600 + 1000 + 3000}mA\n	- ~5v for Vin_prim for ~10% more effeciency in sw regs\n	- ~3v3 max current, non-failure worst case\n	 = sum(LDO[1,2,6,5])\n	 = @{800 + 800 + 350 + 800}mA\n	- ~3v3 for Vin_sec for reduced ldo losses. <300mV_{do}"
		(exclude_from_sim no)
		(at 215.9 19.05 0)
		(size 67.31 43.18)
