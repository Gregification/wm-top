	(text_box "design notes:\n	- the bridge IC's are in low supply\n		- YT8521  : ~$5\n		- DP83869 : ~$10\n		- DP83869 (ext) : ~$19  <- stocked sometimes\n		- Marvell 88E1512 : ~$25 <- bruh\n		- RTL8211FS : ~$3 <- stocked by foreign vendors\n			- https://www.lcsc.com/product-detail/C2844012.html\n			- only \"RTL8211FS-VS-CG\" and \"RTL8211FSI-VS-CG\" support PTP, the I is for industrial grade\n	- max freq wires are the HS IO diff paris, 1.25GHz. ODT.\n	- targets SFP MSA standard"
		(exclude_from_sim no)
		(at 204.47 115.57 0)
